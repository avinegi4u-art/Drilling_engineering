# Copy this file to .env and adjust locally. Do not commit secrets.

# PostgreSQL (used when DATABASE_URL is unset)
POSTGRES_USER=mpd
POSTGRES_PASSWORD=mpd
POSTGRES_DB=mpd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional full SQLAlchemy URL. Overrides POSTGRES_* when set.
# Production example:
# DATABASE_URL=postgresql+psycopg2://mpd:mpd@localhost:5432/mpd
# Local / test example:
# DATABASE_URL=sqlite:///./mpd.db

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Streamlit
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO
